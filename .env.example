# Copy to .env.local (staging) / Vercel env (production). Never commit real values.
DATABASE_URL=
PAYLOAD_SECRET=
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Media on Cloudflare R2 (bucket atsnee-media, public at media.atsnee.org)
R2_ENDPOINT=
R2_BUCKET=atsnee-media
R2_PUBLIC_URL=https://media.atsnee.org
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Contact form: reCAPTCHA v3 keys (google.com/recaptcha/admin) and the inbox that gets a copy of each message
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET=
CONTACT_INBOX=
